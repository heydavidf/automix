# Copy to bot/.env and fill in. bot/.env is gitignored - never commit the token.

# Discord developer portal > your application > Bot > Reset Token (shown once)
BOT_TOKEN=

# Discord app > Settings > Advanced > Developer Mode ON, then
# right-click the server name > Copy Server ID
GUILD_ID=

# right-click the target voice channel > Copy Channel ID
VOICE_CHANNEL_ID=

# Localhost WebSocket port the browser connects to (default 8765)
WS_PORT=8765
